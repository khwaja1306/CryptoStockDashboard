<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Crypto & Stock Dashboard</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CryptoStockDashboard.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom border-secondary shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">
                    <i class="bi bi-graph-up-arrow text-success me-2"></i>CryptoStock Dashboard
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">
                                <i class="bi bi-speedometer2 me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Crypto">
                                <i class="bi bi-currency-bitcoin me-1"></i>Crypto
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Stocks">
                                <i class="bi bi-bar-chart-line me-1"></i>S&P 500
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Predictions">
                                <i class="bi bi-robot me-1"></i>Predictions
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="text-light me-3 small">
                                <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                            </span>
                            <form method="post" asp-page="/Account/Logout" class="d-inline">
                                <button type="submit" class="btn btn-outline-secondary btn-sm me-2">
                                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-page="/Account/Login" class="btn btn-outline-info btn-sm me-2">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Login
                            </a>
                            <a asp-page="/Account/Register" class="btn btn-outline-success btn-sm me-2">
                                <i class="bi bi-person-plus me-1"></i>Register
                            </a>
                        }
                        <span id="connectionStatus" class="badge bg-secondary me-2">
                            <i class="bi bi-circle-fill me-1"></i>Connecting...
                        </span>
                        <span id="lastUpdated" class="text-muted small"></span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4">
        <main role="main" class="py-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top border-secondary footer text-muted py-3 mt-4">
        <div class="container-fluid px-4">
            <div class="d-flex justify-content-between">
                <span>&copy; 2026 - CryptoStock Dashboard</span>
                <span class="small">Real-time data powered by SignalR &bull; Predictions by ML.NET</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
